---
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { site } from '../data/site';
import { blogImages } from '../data/blogImages';
import { categoryHref } from '../data/blogCategories';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, category, pubDate, updatedDate, faqs } = post.data;
const hero = blogImages[post.id];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (h: string) => (h.startsWith('http') ? h : `${base}${h}`);

const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const ogImage = await getImage({ src: hero.src, width: 1200, height: 630, fit: 'cover' });
const ogImageUrl = new URL(ogImage.src, Astro.site ?? Astro.url.origin).href;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(withBase('/'), Astro.site ?? Astro.url.origin).href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL(withBase('/blog'), Astro.site ?? Astro.url.origin).href },
    { '@type': 'ListItem', position: 3, name: title, item: Astro.url.href },
  ],
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: ogImageUrl,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: Astro.url.href,
};
---

<BaseLayout title={`${title} | ${site.name}`} description={description} image={hero.src} jsonLd={[articleLd, breadcrumbLd]}>
  <article class="bg-white py-16 md:py-20">
    <div class="container mx-auto px-4 max-w-3xl">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-500 mb-6">
        <a href={withBase('/')} class="hover:text-primary">Home</a>
        <span class="mx-2">/</span>
        <a href={withBase('/blog')} class="hover:text-primary">Blog</a>
      </nav>

      <a href={withBase(categoryHref[category])} class="category-pill mb-4 inline-block">{category}</a>
      <h1 class="font-display font-bold text-3xl md:text-5xl text-ink mb-4">{title}</h1>
      <p class="text-slate-500 text-sm mb-8">
        Published {dateFmt(pubDate)}
        {updatedDate && ` · Updated ${dateFmt(updatedDate)}`}
        {' · '}{site.name}
      </p>

      <img
        src={ogImage.src}
        alt={hero.alt}
        width={1200}
        height={630}
        class="rounded-2xl w-full shadow-card mb-10 object-cover"
      />

      <div class="article-content">
        <slot />
      </div>
    </div>
  </article>

  {faqs && faqs.length > 0 && <FaqAccordion heading="Frequently Asked Questions" faqs={faqs} />}

  <CtaBanner
    heading="Have a project like this in mind?"
    sub="Tell us about your property and what you're trying to fix — we'll follow up with a real plan, not a form-letter quote."
  />
</BaseLayout>
