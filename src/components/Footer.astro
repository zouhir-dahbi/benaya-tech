---
import { site, social } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (href.startsWith('http') ? href : `${base}${href}`);
const year = new Date().getFullYear();
---

<footer class="bg-ink text-slate-300">
  <div class="container mx-auto px-4 py-16">
    <div class="grid md:grid-cols-4 gap-10 mb-12">
      <div class="md:col-span-1">
        <a href={withBase('/')} class="inline-flex items-center leading-none mb-4">
          <span class="font-display font-bold text-2xl text-white tracking-tight">{site.shortName}</span>
        </a>
        <p class="text-sm text-slate-400 mb-5">
          Smart home, Wi-Fi, security, and technology installation for homes and small businesses throughout Northern Virginia.
        </p>
        <div class="flex items-center gap-3">
          <a href={social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Benaya Tech on Facebook" class="w-9 h-9 rounded-full border border-white/10 flex items-center justify-center hover:border-primary-light hover:text-primary-light transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" /></svg>
          </a>
          <a href={social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Benaya Tech on Instagram" class="w-9 h-9 rounded-full border border-white/10 flex items-center justify-center hover:border-primary-light hover:text-primary-light transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="2" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" /><line x1="17.5" y1="6.5" x2="17.5" y2="6.5" stroke-width="2" stroke-linecap="round" /></svg>
          </a>
          <a href={social.youtube} target="_blank" rel="noopener noreferrer" aria-label="Benaya Tech on YouTube" class="w-9 h-9 rounded-full border border-white/10 flex items-center justify-center hover:border-primary-light hover:text-primary-light transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22.54 6.42a2.78 2.78 0 00-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 00-1.94 2A29 29 0 001 11.75a29 29 0 00.46 5.33A2.78 2.78 0 003.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 001.94-2 29 29 0 00.46-5.25 29 29 0 00-.46-5.33z" /><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" stroke-width="2" stroke-linejoin="round" /></svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="font-display font-semibold text-white text-lg mb-4">Quick Links</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={withBase('/')} class="hover:text-primary-light transition-colors">Home</a></li>
          <li><a href={withBase('/small-business')} class="hover:text-primary-light transition-colors">Small Business</a></li>
          <li><a href={withBase('/service-areas')} class="hover:text-primary-light transition-colors">Service Areas</a></li>
          <li><a href={withBase('/blog')} class="hover:text-primary-light transition-colors">Blog</a></li>
          <li><a href={withBase('/about')} class="hover:text-primary-light transition-colors">About</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-display font-semibold text-white text-lg mb-4">Services</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={withBase('/smart-home')} class="hover:text-primary-light transition-colors">Smart Home</a></li>
          <li><a href={withBase('/wifi-networking')} class="hover:text-primary-light transition-colors">Wi-Fi &amp; Networking</a></li>
          <li><a href={withBase('/security')} class="hover:text-primary-light transition-colors">Security</a></li>
          <li><a href={withBase('/installation')} class="hover:text-primary-light transition-colors">Installation</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-display font-semibold text-white text-lg mb-4">Get in Touch</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href={site.phoneHref} class="inline-flex items-center gap-2 font-semibold hover:text-primary-light transition-colors">
              <svg class="w-4 h-4 text-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              Call Us
            </a>
          </li>
          <li>
            <a href={site.emailHref} class="inline-flex items-center gap-2 hover:text-primary-light transition-colors">
              <svg class="w-4 h-4 text-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              {site.email}
            </a>
          </li>
          <li>
            <a href={withBase('/contact')} class="inline-flex items-center gap-2 hover:text-primary-light transition-colors">
              <svg class="w-4 h-4 text-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H8l-4 4V7a2 2 0 012-2z" /></svg>
              Contact form
            </a>
          </li>
          <li>
            <a href={withBase('/contact')} class="btn-primary text-sm mt-1">Request Service</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 text-center text-sm text-slate-500">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
