---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';

// Set PUBLIC_FORMSPREE_ID in .env (see .env.example) to enable submissions.
const formId = import.meta.env.PUBLIC_FORMSPREE_ID || '';
const formAction = `https://formspree.io/f/${formId || 'YOUR_FORM_ID'}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Request Service | Benaya Tech"
  description="Tell us what you're trying to accomplish — smart home, Wi-Fi, security, or technology installation — for your home or small business in Northern Virginia."
>
  <PageHeader
    center={true}
    title="Tell Us What You Need"
    sub="No technical knowledge required. Tell us a bit about your property and what you're trying to accomplish, and we'll follow up to plan next steps."
  />

  <!-- Prefer to call -->
  <section class="bg-white pt-10 -mb-6">
    <div class="container mx-auto px-4 text-center">
      <p class="text-slate-600">
        Prefer to call or email?
        <a href={site.phoneHref} class="btn-outline text-sm px-4 py-2 ml-3 inline-flex items-center gap-2 align-middle">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          Call Us
        </a>
        <a href={site.emailHref} class="btn-outline text-sm px-4 py-2 ml-2 inline-flex items-center gap-2 align-middle">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          {site.email}
        </a>
      </p>
    </div>
  </section>

  <section class="bg-slate-50 py-16">
    <div class="container mx-auto px-4 max-w-3xl">
      <div x-data="assessmentForm()" x-init="init()" class="card p-6 sm:p-10">
        <!-- Success -->
        <div x-show="submitted" x-cloak class="card p-12 text-center">
          <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          </div>
          <h2 class="font-display font-bold text-2xl text-ink mb-2">Thanks — we've got it.</h2>
          <p class="text-slate-600">We'll follow up to plan next steps and answer any questions before we visit.</p>
        </div>

        <!-- Error -->
        <div x-show="error" x-cloak role="alert" class="mb-6 border border-red-200 bg-red-50 rounded-lg p-4 text-sm text-red-700">
          <span x-text="error"></span>
        </div>

        <!-- Form -->
        <form x-show="!submitted" x-cloak @submit.prevent="submitForm($event)" method="POST" action={formAction} class="space-y-8">
          <input type="hidden" name="_subject" value="New service request — Benaya Tech website" />
          <!-- Honeypot: hidden from humans, catches most bots -->
          <div class="hidden" aria-hidden="true">
            <label>Leave this field empty:<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
          </div>

          <fieldset>
            <legend class="mb-4">
              <span class="form-step"><span class="form-step-number">1</span>Who is this for?</span>
            </legend>
            <div class="grid grid-cols-2 gap-3 sm:gap-4">
              <label class="select-card" :class="{ selected: customerType === 'residential' }">
                <input type="radio" name="customer_type" value="residential" x-model="customerType" class="sr-only" />
                <svg class="w-6 h-6 text-primary mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 11l9-8 9 8M5 10v10a1 1 0 001 1h3v-6h6v6h3a1 1 0 001-1V10" /></svg>
                <span class="font-semibold text-ink">My home</span>
                <span class="text-xs text-slate-500">House, townhome, or condo</span>
                <svg class="select-card-check" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.7-9.3a1 1 0 00-1.4-1.4L9 10.6 7.7 9.3a1 1 0 00-1.4 1.4l2 2a1 1 0 001.4 0l4-4z" clip-rule="evenodd" /></svg>
              </label>
              <label class="select-card" :class="{ selected: customerType === 'commercial' }">
                <input type="radio" name="customer_type" value="commercial" x-model="customerType" class="sr-only" />
                <svg class="w-6 h-6 text-primary mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M5 21V5a1 1 0 011-1h7a1 1 0 011 1v16M14 21V9h4a1 1 0 011 1v11M8 8h3M8 12h3M8 16h3" /></svg>
                <span class="font-semibold text-ink">My business</span>
                <span class="text-xs text-slate-500">Office, retail, or multi-site</span>
                <svg class="select-card-check" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.7-9.3a1 1 0 00-1.4-1.4L9 10.6 7.7 9.3a1 1 0 00-1.4 1.4l2 2a1 1 0 001.4 0l4-4z" clip-rule="evenodd" /></svg>
              </label>
            </div>
          </fieldset>

          <h2 class="form-step -mb-4 w-full border-t border-slate-200 pt-6">
            <span class="form-step-number">2</span>Your details
            <span class="ml-1 text-xs font-normal text-slate-400">* required</span>
          </h2>

          <div class="grid sm:grid-cols-2 gap-6">
            <div><label class="form-label" for="name">Full Name <span class="text-primary" aria-hidden="true">*</span></label><input class="form-input" type="text" id="name" name="name" required /></div>
            <div><label class="form-label" for="email">Email <span class="text-primary" aria-hidden="true">*</span></label><input class="form-input" type="email" id="email" name="email" required /></div>
          </div>
          <div class="grid sm:grid-cols-2 gap-6">
            <div><label class="form-label" for="phone">Phone</label><input class="form-input" type="tel" id="phone" name="phone" /></div>
            <div><label class="form-label" for="city">City / Service Area</label><input class="form-input" type="text" id="city" name="city" placeholder="e.g. Ashburn, VA" /></div>
          </div>

          <!-- What they need -->
          <div class="space-y-3 border-t border-slate-200 pt-6" role="group" aria-labelledby="needs-heading">
            <h2 id="needs-heading" class="form-step"><span class="form-step-number">3</span>What do you need help with?</h2>
            <p class="text-sm text-slate-500">Select all that apply.</p>
            <div class="grid sm:grid-cols-2 gap-3">
              {[
                ['Wi-Fi / Networking', 'wifi_networking'],
                ['Smart Home', 'smart_home'],
                ['Security Cameras', 'security_cameras'],
                ['TV / Technology Installation', 'tv_installation'],
                ['Smart Locks / Doorbells', 'smart_locks_doorbells'],
                ['Home Office', 'home_office'],
                ['Small Business', 'small_business'],
                ['Troubleshooting', 'troubleshooting'],
                ['Other', 'other'],
              ].map(([label, value]) => (
                <label class="flex items-center gap-3 text-sm text-slate-700 py-1.5">
                  <input type="checkbox" name="needs" value={value} class="w-5 h-5 shrink-0 rounded border-slate-300 text-primary focus:ring-2 focus:ring-primary/20" />
                  {label}
                </label>
              ))}
            </div>
          </div>

          <h2 x-show="customerType" x-cloak class="form-step -mb-4 w-full border-t border-slate-200 pt-6"><span class="form-step-number">4</span>Property details</h2>

          <!-- Residential -->
          <div x-show="customerType === 'residential'" x-cloak class="grid sm:grid-cols-2 gap-6">
            <div>
              <label class="form-label" for="r_property_type">Property Type</label>
              <select class="form-input" id="r_property_type" name="property_type">
                <option value="">Select one</option><option>Single-family home</option><option>Townhouse</option><option>Condo / apartment</option><option>Other</option>
              </select>
            </div>
            <div>
              <label class="form-label" for="r_timeline">Desired Timeline</label>
              <select class="form-input" id="r_timeline" name="timeline"><option value="">Select one</option><option>As soon as possible</option><option>Within a month</option><option>Just exploring options</option></select>
            </div>
          </div>

          <!-- Commercial -->
          <div x-show="customerType === 'commercial'" x-cloak class="grid sm:grid-cols-2 gap-6">
            <div><label class="form-label" for="c_property_type">Business / Property Type</label><input class="form-input" type="text" id="c_property_type" name="business_type" placeholder="e.g. retail, office, warehouse" /></div>
            <div>
              <label class="form-label" for="c_locations">Number of Locations</label>
              <select class="form-input" id="c_locations" name="location_count"><option value="">Select one</option><option>1</option><option>2&ndash;3</option><option>4 or more</option></select>
            </div>
            <div class="sm:col-span-2">
              <label class="form-label" for="c_timeline">Desired Timeline</label>
              <select class="form-input" id="c_timeline" name="timeline"><option value="">Select one</option><option>As soon as possible</option><option>Within a month</option><option>Just exploring options</option></select>
            </div>
          </div>

          <div><label class="form-label" for="notes">Tell us what you're trying to accomplish</label><textarea class="form-input" id="notes" name="notes" rows="4" placeholder="e.g. Wi-Fi doesn't reach the upstairs bedrooms, and I'd also like a video doorbell installed"></textarea></div>

          <div class="border-t border-slate-200 pt-6 space-y-4">
            <label class="flex items-start gap-3 text-sm text-slate-700">
              <input type="checkbox" name="email_opt_in" value="yes" class="mt-0.5 w-5 h-5 shrink-0 rounded border-slate-300 text-primary focus:ring-2 focus:ring-primary/20" />
              <span>Email me occasional maintenance reminders, tips, and offers from {site.name}. Optional — unsubscribe any time.</span>
            </label>
            <p class="text-xs text-slate-500">
              We'll reply about this request either way. By submitting, you agree to our{' '}
              <a href={`${base}/privacy`} class="underline underline-offset-2 hover:text-primary">Privacy Policy</a> and{' '}
              <a href={`${base}/terms`} class="underline underline-offset-2 hover:text-primary">Terms &amp; Conditions</a>.
            </p>
          </div>

          <button type="submit" class="btn-primary w-full text-lg" :disabled="sending">
            <span x-show="!sending">Send Request</span>
            <span x-show="sending" x-cloak>Sending...</span>
          </button>
        </form>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ FORM_ID: formId, FORM_ACTION: formAction }}>
    window.assessmentForm = function assessmentForm() {
      return {
        customerType: null,
        submitted: false,
        sending: false,
        error: null,
        init() {
          const params = new URLSearchParams(window.location.search);
          const type = params.get('type');
          if (type === 'residential' || type === 'commercial') this.customerType = type;
        },
        async submitForm(event) {
          if (!FORM_ID) {
            this.error = 'The online form is not available yet. Please call us instead.';
            return;
          }
          this.sending = true;
          this.error = null;
          const data = new FormData(event.target);
          try {
            const res = await fetch(FORM_ACTION, {
              method: 'POST',
              body: data,
              headers: { Accept: 'application/json' },
            });
            if (!res.ok) throw new Error('Form submission failed');
            this.submitted = true;
          } catch (err) {
            this.error = 'Something went wrong sending your request. Please try again, or call us.';
          } finally {
            this.sending = false;
          }
        },
      };
    }
  </script>
</BaseLayout>
