# Copy to .env and fill in real values before deploying.

# Production site URL — used for the sitemap, canonical URLs, and Open Graph tags.
# Must be a valid https:// URL without a trailing slash.
SITE_URL=https://example.com

# Base path — only set to a non-'/' value when hosting under a subpath
# (e.g. BASE_PATH=/benaya-tech for a GitHub project page).
BASE_PATH=/

# Formspree form ID (create one at https://formspree.io) — required for the
# contact form to actually send submissions. Leave empty to disable the form
# with a "call us instead" message.
PUBLIC_FORMSPREE_ID=
